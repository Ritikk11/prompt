# GEMINI_API_KEY: Optional. Required only for Gemini-powered admin generation.
GEMINI_API_KEY="your_gemini_api_key"

# Model Studio (MaaS) / OpenAI-compatible API (e.g. DeepSeek V4 Pro/Flash, Qwen 3.8)
# MAAS_API_KEY="your_maas_api_key"
# MAAS_BASE_URL="https://.../compatible-mode/v1"
# MAAS_DEFAULT_MODEL="deepseek-v4-pro"

# Public site URL used for links, metadata, and auth callbacks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase project values.
NEXT_PUBLIC_SUPABASE_URL="your_supabase_url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_server_only_service_role_key"

# Server-only integration secrets. Add these as deployed secrets, not public vars.
PINTEREST_APP_SECRET="your_pinterest_app_secret"

# Admin access. Use a comma-separated list for multiple admins.
ADMIN_EMAILS="admin@example.com"

# Public URL for Cloudflare R2 uploads when the upload platform is Cloudflare.
CLOUDFLARE_UPLOAD_PUBLIC_URL="https://uploads.example.com"
NEXT_PUBLIC_ENABLE_CLOUDFLARE_IMAGE_RESIZE="true"

# Secret required for hitting the on-demand revalidation endpoint
REVALIDATION_SECRET="my_random_secret_token"
