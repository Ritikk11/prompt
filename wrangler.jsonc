{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aipromptmatrix-opennext-staging",
  "account_id": "782cdf2aa31f278ca25d0cedfb54a3af",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-05-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "uploads"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "aipromptmatrix-isr-cache"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aipromptmatrix-opennext-staging"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"]
    }
  ],
  "vars": {
    "CACHE_PURGE_ZONE_ID": "a33cd99c0aef37417fa37f5c8da6d1f9",
    "NEXT_PUBLIC_SITE_URL": "https://promptsoul.in",
    "NEXT_PUBLIC_ENABLE_CLOUDFLARE_IMAGE_RESIZE": "false",
    "NEXT_PUBLIC_SUPABASE_URL": "https://fcmmcgyqovqbxbqfeaho.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZjbW1jZ3lxb3ZxYnhicWZlYWhvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkzNzA1NjksImV4cCI6MjA5NDk0NjU2OX0.ehK_nECpmlaQCItQFYGoC_uKRrujLInferDOlxZBmus",
    "CLOUDFLARE_UPLOAD_PUBLIC_URL": "https://uploads.aipromptmatrix.in"
  },
  "observability": {
    "enabled": true
  }
}
