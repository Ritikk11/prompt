{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aipromptmatrix-opennext-staging",
  "account_id": "782cdf2aa31f278ca25d0cedfb54a3af",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-05-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "uploads"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "aipromptmatrix-opennext-staging"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://aipromptmatrix.in",
    "NEXT_PUBLIC_SUPABASE_URL": "https://fcmmcgyqovqbxbqfeaho.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZjbW1jZ3lxb3ZxYnhicWZlYWhvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkzNzA1NjksImV4cCI6MjA5NDk0NjU2OX0.ehK_nECpmlaQCItQFYGoC_uKRrujLInferDOlxZBmus",
    "CLOUDFLARE_UPLOAD_PUBLIC_URL": "https://uploads.aipromptmatrix.in"
  },
  "observability": {
    "enabled": true
  }
}
